{
  "name": "jslt-js",
  "version": "0.1.8",
  "description": "JavaScript port of Schibsted JSLT — JSON query and transformation language (https://github.com/schibsted/jslt)",
  "license": "Apache-2.0",
  "author": "Anton Kraev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amkraev697642/jslt-js.git"
  },
  "homepage": "https://github.com/amkraev697642/jslt-js#readme",
  "bugs": {
    "url": "https://github.com/amkraev697642/jslt-js/issues"
  },
  "keywords": [
    "jslt",
    "json",
    "transform",
    "transformation",
    "query",
    "jq",
    "jackson",
    "port"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "./dist/jslt.cjs",
  "browser": "./src/index.js",
  "unpkg": "./dist/jslt-bundle.js",
  "jsdelivr": "./dist/jslt-bundle.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/jslt.cjs",
      "default": "./src/index.js"
    },
    "./bundle": "./dist/jslt-bundle.js",
    "./extensions": {
      "import": "./src/extensions/index.js",
      "require": "./dist/jslt.cjs"
    }
  },
  "bin": {
    "jslt": "./src/cli.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "build:playground": "node scripts/playground.mjs",
    "prepublishOnly": "node scripts/bundle.mjs",
    "test": "node --test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "js-yaml": "^4.1.0",
    "jslt-node": "^0.0.6"
  }
}
